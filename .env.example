# Product Hunt v2 developer token
# Get one at https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_API_TOKEN=

# Serper.dev API key -- https://serper.dev
SERPER_API_KEY=

# Ahrefs API token -- shows Domain Rating next to each website
# https://ahrefs.com/api  (uses the free domain-rating-free endpoint)
AHREFS_API_KEY=

# Apify API token -- primary domain + email resolver (Contact Info Scraper
# actor), crawls each product's real site instead of just Google snippets.
# https://apify.com -> Settings -> Integrations -> Personal API token
# Without this, Huntbox falls back to Serper-only resolution.
APIFY_API_TOKEN=

# Optional tuning
SERPER_CONCURRENCY=3
SERPER_DELAY_SECONDS=0.35
APIFY_CONCURRENCY=2
DOMAIN_AGE_CONCURRENCY=2
LOG_LEVEL=INFO
